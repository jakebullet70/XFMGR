{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Prog8",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\compile.ps1",
        "${file}",
        "${config:prog8.compilerJar}",
        "${config:prog8.64tassFolder}",
        "${config:prog8.x16Emulator}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}